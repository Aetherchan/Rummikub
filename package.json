{
  "name": "rummikub",
  "version": "0.1.0",
  "private": true,
  "description": "以色列麻将（Rummikub）线上游戏",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces",
    "pretest": "cd packages/shared && npx tsc -b --force && cd ../engine && npx tsc -b --force",
    "test": "cd packages/engine && npx vitest run",
    "lint": "eslint packages/*/src --ext .ts,.tsx",
    "clean": "rimraf packages/*/dist packages/*/node_modules",
    "prebuild:ghpages": "cd packages/shared && npx tsc -b --force && cd ../engine && npx tsc -b --force",
    "build:ghpages": "cd packages/client && npx vite build --outDir ../../docs",
    "preview": "cd packages/client && npx vite preview"
  },
  "devDependencies": {
    "typescript": "^5.8.0",
    "rimraf": "^6.0.0"
  }
}
